{
  "name": "metalensvgc",
  "version": "1.9.0",
  "scripts": {
    "data": "node scripts/build-data.js",
    "pokedex": "node scripts/build-pokedex.js",
    "release": "node scripts/release.js",
    "export": "node -e \"import('./scripts/lib/research-export.js').then(m=>m.writeExport('public/data','data-export',['M-A','M-B','M-C']))\"",
    "test": "node --test",
    "serve": "node scripts/serve.js",
    "e2e": "playwright test",
    "shot": "playwright test e2e/screenshots.spec.js",
    "e2e:cloud": "playwright test -c playwright.cloud.config.js e2e/app.spec.js"
  },
  "license": "MIT",
  "author": "Vin, Vin's Atelier (https://vwesley.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentwesley/MetaLensVGC.git"
  },
  "description": "MetaLens VGC: cross-filtering metagame dashboard for Pokémon Champions (VGC 2026)",
  "dependencies": {
    "echarts": "^5.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "pokemon-showdown": "^0.11.11"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tar": "7.5.22",
    "nodemailer": "10.3.1",
    "uuid": "14.0.3",
    "@tootallnate/once": "3.0.1"
  }
}
